# --- InfluxDB 설정 ---
INFLUXDB_URL="http://localhost:8086"
# 관리자 UI에서 발급받은 API 토큰을 입력하세요.
INFLUXDB_TOKEN="your_influxdb_token_here" 
INFLUXDB_ORG="sensor_hq"
INFLUXDB_BUCKET="sensor_data"

# --- MQTT 설정 ---
MQTT_BROKER="127.0.0.1"
MQTT_PORT=1883

# --- AI 설정 ---
AI_URL = "http://127.0.0.1:8002"

# --- MARIADB ----
MARIADB_URL="mysql+pymysql://sensor_user:sensor_password@127.0.0.1:3306/sensor_db"